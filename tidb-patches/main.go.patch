+// createReadOnlyDomain builds a Domain for PCR read-only mode with periodic
+// schema reload (5s ticker). Uses a lazy session factory — individual sessions
+// may hit DefaultNotFound on mDB reads but that won't crash the server.
+func createReadOnlyDomain(storage kv.Storage) *domain.Domain {
+	factory := func() (pools.Resource, error) {
+		ses, err := session.CreateSession(storage)
+		if err != nil {
+			log.Warn("PCR: lazy session creation failed", zap.Error(err))
+			return nil, err
+		}
+		return ses, nil
+	}
+	dom := domain.NewDomain(storage, 45*time.Second, 3*time.Second, 0, factory)
+	log.Info("PCR: bare read-only domain created (no schema load, lazy sessions)")
+	return dom
+}
