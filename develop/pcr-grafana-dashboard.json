{
  "title": "TiKV PCR Demo — Replication Monitor",
  "uid": "pcr-demo",
  "refresh": "5s",
  "time": { "from": "now-5m", "to": "now" },
  "panels": [
    {
      "id": 1, "title": "PCR State", "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 3 },
      "targets": [{ "expr": "pcr_state", "legendFormat": "state" }],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "steps": [{ "color": "red", "value": 0 }, { "color": "yellow", "value": 1 }, { "color": "green", "value": 2 }, { "color": "red", "value": 5 }] },
          "mappings": [{ "type": "value", "value": "" }, { "type": "value", "value": "0", "text": "Idle" }, { "type": "value", "value": "1", "text": "Subscribing" }, { "type": "value", "value": "2", "text": "Paused" }, { "type": "value", "value": "3", "text": "CuttingOver" }, { "type": "value", "value": "4", "text": "Completed" }, { "type": "value", "value": "5", "text": "Activated" }, { "type": "value", "value": "6", "text": "Failed" }]
        }
      }
    },
    {
      "id": 2, "title": "Standby Read Lag", "type": "gauge",
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 3 },
      "targets": [{ "expr": "pcr_checkpoint_lag_seconds", "legendFormat": "lag" }],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": { "steps": [{ "color": "green", "value": 0 }, { "color": "green", "value": 2 }, { "color": "yellow", "value": 10 }, { "color": "red", "value": 60 }] },
          "min": 0, "max": 60
        }
      }
    },
    {
      "id": 3, "title": "Replicated Time", "type": "stat",
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 3 },
      "targets": [{ "expr": "pcr_frontier_min_ts / 1000", "legendFormat": "ts_ms" }],
      "fieldConfig": { "defaults": { "unit": "dateTimeAsIso" } }
    },

    {
      "id": 10, "title": "Ingest Throughput (bytes/s)", "type": "graph",
      "gridPos": { "x": 0, "y": 3, "w": 8, "h": 4 },
      "targets": [{ "expr": "rate(pcr_ingested_bytes_total[30s])", "legendFormat": "bytes/s" }],
      "fieldConfig": { "defaults": { "unit": "Bps" } }
    },
    {
      "id": 11, "title": "Ingest Throughput (KVs/s)", "type": "graph",
      "gridPos": { "x": 8, "y": 3, "w": 8, "h": 4 },
      "targets": [{ "expr": "rate(pcr_ingested_kvs_total[30s])", "legendFormat": "kvs/s" }],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 12, "title": "Producer Bytes Sent", "type": "graph",
      "gridPos": { "x": 16, "y": 3, "w": 8, "h": 4 },
      "targets": [{ "expr": "rate(pcr_bridge_bytes_sent_total[30s])", "legendFormat": "bytes/s" }],
      "fieldConfig": { "defaults": { "unit": "Bps" } }
    },

    {
      "id": 20, "title": "SST Sort Latency", "type": "graph",
      "gridPos": { "x": 0, "y": 7, "w": 8, "h": 4 },
      "targets": [{ "expr": "rate(pcr_sst_sort_latency_seconds_sum[1m]) / rate(pcr_sst_sort_latency_seconds_count[1m])", "legendFormat": "sort ms" }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 21, "title": "SST Generate Latency", "type": "graph",
      "gridPos": { "x": 8, "y": 7, "w": 8, "h": 4 },
      "targets": [{ "expr": "rate(pcr_sst_generate_latency_seconds_sum[1m]) / rate(pcr_sst_generate_latency_seconds_count[1m])", "legendFormat": "gen ms" }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 22, "title": "SST Ingest Latency", "type": "graph",
      "gridPos": { "x": 16, "y": 7, "w": 8, "h": 4 },
      "targets": [{ "expr": "rate(pcr_sst_ingest_latency_seconds_sum[1m]) / rate(pcr_sst_ingest_latency_seconds_count[1m])", "legendFormat": "ingest ms" }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },

    {
      "id": 30, "title": "Per-Region Lag (top 5)", "type": "graph",
      "gridPos": { "x": 0, "y": 11, "w": 8, "h": 4 },
      "targets": [{ "expr": "topk(5, pcr_region_lag_seconds)", "legendFormat": "region {{region_id}}" }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 31, "title": "Errors", "type": "graph",
      "gridPos": { "x": 8, "y": 11, "w": 8, "h": 4 },
      "targets": [{ "expr": "rate(pcr_errors_total[1m])", "legendFormat": "{{type}}" }],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 32, "title": "Full Scan Progress", "type": "gauge",
      "gridPos": { "x": 16, "y": 11, "w": 8, "h": 4 },
      "targets": [{ "expr": "pcr_snapshot_regions_scanned", "legendFormat": "regions" }],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "max": 80 } }
    }
  ]
}